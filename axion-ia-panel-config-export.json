            "sidebar_position": 1,
            "title": "{{titulo}}",
            "description": "{{descricao}}",
            "last_update": {
              "date": "{{dataAtualizacao}}",
              "author": "Sistema Automático AxionIA"
            }
          },
          
          "secoes": [
            {
              "nome": "introducao",
              "template": "# {{titulo}}\n\n{{descricaoCurta}}\n\n## ✨ Novidades {{versao}}\n\n{{listaNovidades}}"
            },
            {
              "nome": "comoAcessar",
              "template": "---\n\n## Como acessar\n\n{{instrucoes}}\n\n![{{nomeImagem}}](../img/{{arquivoImagem}})"
            },
            {
              "nome": "funcionalidades",
              "template": "---\n\n## {{tituloFuncionalidade}}\n\n{{descricaoFuncionalidade}}\n\n{{conteudoFuncionalidade}}"
            },
            {
              "nome": "api",
              "template": "---\n\n## API - Endpoints\n\n{{listaEndpoints}}"
            },
            {
              "nome": "dicas",
              "template": "---\n\n## Dicas de Uso\n\n{{listaDicas}}"
            },
            {
              "nome": "solucaoProblemas",
              "template": "---\n\n## Solução de Problemas\n\n{{listaProblemas}}"
            },
            {
              "nome": "rodape",
              "template": "---\n\n**Última atualização:** {{dataFormatada}}\n**Versão:** {{versao}}\n**Status:** {{status}}"
            }
          ]
        }
      }
