        "templateResposta": {
          "formato": "markdown",
          "secoes": [
            {
              "nome": "cabecalho",
              "template": "# Validação Técnica - Relatório de Passagens AxCross v{{versao}}\n\n**Data da Validação:** {{dataValidacao}}\n**Técnico:** Sistema Automático de Validação AxionIA\n**Status:** {{statusEmoji}} **{{statusTexto}}** ({{conformidade}}% de conformidade)"
            },
            {
              "nome": "resumoExecutivo",
              "template": "## 📊 Resumo Executivo\n\n| Categoria | Testados | ✅ Passou | ❌ Falhou | ⚠️ Parcial |\n|-----------|:--------:|:--------:|:--------:|:--------:|\n{{tabelaResultados}}\n| **TOTAL** | **{{totalTestes}}** | **{{totalPassou}}** | **{{totalFalhou}}** | **{{totalParcial}}** |"
            },
            {
              "nome": "implementado",
              "template": "## ✅ O que está funcionando\n\n{{listaImplementado}}"
            },
            {
              "nome": "faltante",
              "template": "## ❌ O que precisa ser implementado (PRIORITÁRIO)\n\n{{listaFaltante}}"
            },
            {
              "nome": "acoesRecomendadas",
              "template": "## 🎯 Ações Recomendadas\n\n**FASE 1 - Crítico (8 dias úteis):**\n{{fase1}}\n\n**FASE 2 - Importante (9 dias úteis):**\n{{fase2}}\n\n**FASE 3 - Melhoria (5 dias úteis):**\n{{fase3}}\n\n**Cronograma Total:** {{diasTotais}} dias úteis (previsão: {{dataInicio}} - {{dataFim}})"
            },
            {
              "nome": "documentacao",
              "template": "## 📄 Documentação Técnica\n\nRelatório completo disponível em: **{{arquivoRelatorio}}**\n\nDocumentação atualizada em: **{{caminhoDocumentacao}}**"
            },
            {
              "nome": "rodape",
              "template": "---\n\n**Status do Chamado:** {{statusChamado}}\n**Próxima Validação:** {{proximaValidacao}}"
            }
          ],
          
          "statusMapping": {
            "critico": {
              "emoji": "🔴",
              "texto": "NÃO CONFORME",
              "conformidadeMaxima": 30
            },
            "atencao": {
              "emoji": "🟡",
              "texto": "ATENÇÃO NECESSÁRIA",
              "conformidadeMaxima": 70
            },
            "aprovado": {
              "emoji": "🟢",
              "texto": "CONFORME",
              "conformidadeMaxima": 100
            }
          }
        }
      },
      
