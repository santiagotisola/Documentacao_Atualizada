  "evaluationModels": {
    "individual": {
      "description": "Avalia apenas um recurso isoladamente",
      "example": "Cadastro de usuário",
      "scoring": "0-100"
    },
    
    "process": {
      "description": "Avalia um fluxo completo de negócio",
      "example": "Login → Cadastro → Pagamento → Nota Fiscal → Relatório",
      "scoring": "0-100 (weighted)"
    },
    
    "similarity": {
      "description": "Compara dois ambientes ou contratos",
      "pairs": [
        "Produção vs Homologação",
        "Cliente A vs Cliente B",
        "Versão 1.0 vs Versão 2.0"
      ],
      "metrics": ["divergências", "similaridade %"]
    },
    
    "composition": {
      "description": "Avalia grupos de funcionalidades relacionadas",
      "example": "Módulo Financeiro (Cadastro + Emissão + Baixa + Relatórios + Integração + API)",
      "scoring": "0-100 (average)"
    },
    
    "interdependency": {
      "description": "Avalia componentes interdependentes através de grafo",
      "example": "A → B → C → D",
      "analysis": "Impacto em cascata de falhas"
    }
  },
  
