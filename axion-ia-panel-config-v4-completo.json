    "dataReconciliationEngine": {
      "enabled": true,
      "description": "Executa comparações DE/PARA entre ambientes, contratos e fontes de dados",
      
      "comparisonTypes": {
        "environmentComparison": {
          "enabled": true,
          "pairs": [
            {"from": "producao", "to": "homologacao"},
            {"from": "producao", "to": "desenvolvimento"},
            {"from": "homologacao", "to": "desenvolvimento"}
          ]
        },
        
        "contractComparison": {
          "enabled": true,
          "compareFields": [
            "equipamentos",
            "locais",
            "usuarios",
            "permissoes",
            "configuracoes",
            "operacoes"
          ]
        },
        
        "dataSourceComparison": {
          "enabled": true,
          "sources": [
            "database",
            "api",
            "exportedFile",
            "dashboard",
            "report"
          ]
        }
      },
      
      "reconciliationRules": {
        "tolerance": {
          "numeric": 0.01,
          "date": "1 day",
          "string": "case-insensitive"
        },
        
        "fieldMapping": {
          "enabled": true,
          "mappings": [
            {"source": "cod_equipamento", "target": "equipamento_id"},
            {"source": "data_cadastro", "target": "created_at"},
            {"source": "status_ativo", "target": "is_active"}
          ]
        },
        
        "businessKeys": {
          "enabled": true,
          "keys": {
            "equipamento": ["codigo", "local_id"],
            "operacao": ["numero", "contrato_id"],
            "usuario": ["email"]
          }
        }
      },
      
      "divergenceClassification": {
        "critical": {
          "description": "Divergências que impedem o funcionamento",
          "examples": ["Equipamento ausente", "Permissão incorreta"]
        },
        "high": {
          "description": "Divergências que afetam funcionalidades importantes",
          "examples": ["Status inconsistente", "Data divergente"]
        },
        "medium": {
          "description": "Divergências que afetam dados secundários",
          "examples": ["Descrição diferente", "Ordem alterada"]
        },
        "low": {
          "description": "Divergências aceitáveis ou dentro da tolerância",
          "examples": ["Diferença de millisegundos", "Case de texto"]
        }
      }
    },
    
