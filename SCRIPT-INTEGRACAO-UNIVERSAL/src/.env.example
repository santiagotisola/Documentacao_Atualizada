# ================================================
# AXION INTEGRAÇÃO UNIVERSAL — Variáveis de Ambiente
# ================================================
# Copie este arquivo para .env e preencha com seus dados

# === SERVIDOR ===
PORT=3100
NODE_ENV=development
SERVICE_NAME=integracao-universal
CORS_ORIGIN=http://localhost:3017,http://localhost:3000

# === AUTENTICAÇÃO API (vazio = sem auth) ===
API_TOKEN=

# === SEGURANÇA ===
RATE_LIMIT_MAX=100
RATE_LIMIT_IA=20
WEBHOOK_SECRET=
LOG_LEVEL=info

# === INTELIGÊNCIA ARTIFICIAL ===
# Provedor: openai | anthropic | ollama
AI_PROVIDER=openai
AI_API_KEY=sk-proj-SUA_CHAVE_AQUI
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_BASE_URL=https://api.openai.com/v1
# Para Ollama local: AI_BASE_URL=http://localhost:11434/v1

# Thresholds de decisão automática
SCORE_AUTO_RESPOSTA=0.85
SCORE_SUGESTAO=0.65

# === MONGODB (obrigatório) ===
MONGO_URI=mongodb://localhost:27017/integracao-universal

# === HELPDESK ===
# Plataforma: jitbit | zendesk | freshdesk | proprio
HELPDESK_PLATFORM=proprio
HELPDESK_URL=https://desk.empresa.com.br/helpdesk
HELPDESK_USER=admin@empresa.com
HELPDESK_PASS=
HELPDESK_TOKEN=

# === ERP / SISTEMA DE GESTÃO ===
# Tipo conexão: api | banco_direto
ERP_CONNECTION_TYPE=banco_direto
ERP_API_URL=
ERP_API_TOKEN=
ERP_DB_TYPE=mysql
ERP_DB_HOST=localhost
ERP_DB_PORT=3306
ERP_DB_NAME=erp_database
ERP_DB_USER=root
ERP_DB_PASS=

# === BANCO SQL EXTRA 1 (opcional) ===
SQL1_TYPE=sql_server
SQL1_HOST=
SQL1_PORT=1433
SQL1_DB=
SQL1_USER=
SQL1_PASS=
SQL1_ENCRYPT=false

# === BANCO SQL EXTRA 2 (opcional) ===
SQL2_TYPE=
SQL2_HOST=
SQL2_PORT=
SQL2_DB=
SQL2_USER=
SQL2_PASS=

# === WHATSAPP ===
WHATSAPP_ENABLED=true
WHATSAPP_NUMERO=5511999999999
WHATSAPP_AUTH_DIR=./whatsapp-auth
LGPD_POLITICA_URL=https://empresa.com/politica-privacidade.pdf

# === NOTIFICAÇÕES ===
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# === SCHEDULER ===
POLLING_ENABLED=true
POLLING_INTERVAL=2
MODO_REVISAO=true

# === RELATÓRIOS ===
RELATORIO_OUTPUT_DIR=./output/relatorios
