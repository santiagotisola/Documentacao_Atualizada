  "diagrama_relacionamento": {
    "descricao": "Como os sistemas se conectam entre si via esta tabela",
    "fluxo": "Qualquer módulo (01-11) → consulta tabela-relacionamento → obtém conexão → executa operação",
    "exemplo": {
      "modulo_whatsapp_quer_criar_ticket": [
        "1. WhatsApp (módulo 02) precisa criar ticket",
        "2. Consulta tabela: sistemas.find({id: 'helpdesk_principal'})",
        "3. Obtém: base_url, auth_tipo, auth_token",
        "4. Chama: helpdesk-integrador (módulo 03) com conexão obtida",
        "5. Ticket criado no sistema correto"
      ],
      "modulo_relatorio_quer_dados": [
        "1. Gerador de Relatórios (módulo 05) precisa de dados",
        "2. Consulta tabela: sistemas.find({id: 'erp_principal'})",
        "3. Obtém: tipo_conexao (api ou banco), credenciais",
        "4. Chama: banco-dados-adaptador (módulo 06) com conexão",
        "5. Dados retornados, relatório gerado"
      ]
    }
  }
