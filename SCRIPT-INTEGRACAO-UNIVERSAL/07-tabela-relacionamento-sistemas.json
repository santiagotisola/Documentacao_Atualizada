{
  "modulo": "tabela-relacionamento-sistemas",
  "versao": "1.0.0",
  "descricao": "TABELA CENTRAL — Aqui você informa os dados de acesso de TODOS os seus sistemas, módulos e integrações. Os outros módulos consultam esta tabela para saber como se conectar a cada sistema. É o 'hub de configuração' do ecossistema.",
  "instrucoes": [
    "1. Preencha apenas os sistemas que você vai usar",
    "2. Cada sistema tem um 'id' único que é referenciado pelos outros módulos",
    "3. Credenciais devem ser armazenadas em variáveis de ambiente (.env) — aqui coloque apenas os nomes das variáveis",
    "4. Teste cada conexão com GET /api/db/{id}/status antes de usar"
  ],
  "sistemas": [
    {
      "id": "helpdesk_principal",
      "nome": "Sistema de Helpdesk",
      "tipo": "helpdesk",
      "plataforma": "jitbit|zendesk|freshdesk|osticket|glpi|proprio",
      "conexao": {
        "base_url": "ENV:HELPDESK_URL",
        "auth_tipo": "basic|bearer|api_key",
        "auth_user": "ENV:HELPDESK_USER",
        "auth_pass": "ENV:HELPDESK_PASS",
        "auth_token": "ENV:HELPDESK_TOKEN"
      },
      "modulos_habilitados": ["tickets", "categorias", "tecnicos", "sla"],
      "status": "ativo|inativo|configurando"
    },
    {
      "id": "erp_principal",
      "nome": "Sistema ERP / Gestão",
      "tipo": "erp",
      "plataforma": "tekfarma|totvs|sap|bling|custom",
      "conexao": {
        "tipo_conexao": "api_rest|banco_direto|soap",
        "base_url": "ENV:ERP_URL",
        "auth_tipo": "bearer|basic|api_key|oauth2",
        "auth_token": "ENV:ERP_TOKEN",
        "banco_host": "ENV:ERP_DB_HOST",
        "banco_porta": "ENV:ERP_DB_PORT",
        "banco_nome": "ENV:ERP_DB_NAME",
        "banco_user": "ENV:ERP_DB_USER",
        "banco_pass": "ENV:ERP_DB_PASS",
        "banco_tipo": "sql_server|mysql|postgresql"
      },
      "modulos_habilitados": ["estoque", "vendas", "financeiro", "clientes", "fiscal"],
      "status": "ativo|inativo|configurando"
    },
    {
      "id": "banco_principal",
      "nome": "Banco de Dados Principal (NoSQL)",
      "tipo": "banco_dados",
      "plataforma": "mongodb",
      "conexao": {
        "uri": "ENV:MONGO_URI",
        "database": "nome_do_banco"
      },
      "uso": "Sessões, logs, KB, filas, cache",
      "status": "ativo"
    },
    {
      "id": "banco_sql_1",
      "nome": "Banco SQL — Módulo 1",
      "tipo": "banco_dados",
      "plataforma": "sql_server|mysql|postgresql",
      "conexao": {
        "host": "ENV:SQL1_HOST",
        "porta": "ENV:SQL1_PORT",
        "database": "ENV:SQL1_DB",
        "user": "ENV:SQL1_USER",
        "password": "ENV:SQL1_PASS",
        "encrypt": false
      },
      "tabelas_principais": ["Tabela1", "Tabela2", "Tabela3"],
      "status": "ativo|inativo"
    },
    {
      "id": "banco_sql_2",
      "nome": "Banco SQL — Módulo 2",
      "tipo": "banco_dados",
      "plataforma": "sql_server|mysql|postgresql",
      "conexao": {
        "host": "ENV:SQL2_HOST",
        "porta": "ENV:SQL2_PORT",
        "database": "ENV:SQL2_DB",
        "user": "ENV:SQL2_USER",
        "password": "ENV:SQL2_PASS",
        "encrypt": false
      },
      "tabelas_principais": [],
      "status": "inativo"
    },
    {
      "id": "ia_provider",
      "nome": "Provedor de Inteligência Artificial",
      "tipo": "ia",
      "plataforma": "openai|anthropic|google|azure_openai|ollama",
      "conexao": {
        "api_key": "ENV:AI_API_KEY",
        "base_url": "https://api.openai.com/v1 (ou URL do Ollama local)",
        "modelo_chat": "gpt-4o|claude-sonnet-4-20250514|gemini-2.0-flash",
        "modelo_embedding": "text-embedding-3-small"
      },
      "configuracao": {
        "max_tokens": 1500,
        "temperatura": 0.3,
        "custo_estimado_por_1000_msgs": "R$ 20,00"
      },
      "status": "ativo"
    },
    {
      "id": "whatsapp",
      "nome": "WhatsApp Business",
      "tipo": "mensageria",
      "plataforma": "baileys|evolution_api|meta_oficial",
      "conexao": {
        "metodo": "baileys (direto, gratuito)",
        "auth_path": "./whatsapp-auth/",
        "numero": "ENV:WHATSAPP_NUMERO",
        "webhook_url": "ENV:WHATSAPP_WEBHOOK (se usar Evolution/Meta)"
