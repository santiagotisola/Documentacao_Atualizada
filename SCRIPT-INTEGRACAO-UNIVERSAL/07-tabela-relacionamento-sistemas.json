      "configuracao": {
        "lgpd_url": "ENV:LGPD_POLITICA_URL",
        "sessao_ttl_horas": 24,
        "max_msgs_por_dia": 5000
      },
      "status": "ativo|inativo"
    },
    {
      "id": "notificacoes",
      "nome": "Canal de Notificações",
      "tipo": "notificacao",
      "plataforma": "telegram|slack|email|discord",
      "conexao": {
        "telegram_token": "ENV:TELEGRAM_TOKEN",
        "telegram_chat_id": "ENV:TELEGRAM_CHAT_ID",
        "slack_webhook": "ENV:SLACK_WEBHOOK_URL",
        "email_smtp_host": "ENV:SMTP_HOST",
        "email_smtp_port": "ENV:SMTP_PORT",
        "email_user": "ENV:SMTP_USER",
        "email_pass": "ENV:SMTP_PASS"
      },
      "uso": "Alertas de escalamento, relatórios agendados, notificações de erro",
      "status": "ativo|inativo"
    },
    {
      "id": "storage",
      "nome": "Armazenamento de Arquivos",
      "tipo": "storage",
      "plataforma": "local|s3|azure_blob|google_cloud",
      "conexao": {
        "tipo": "local",
        "path_local": "./uploads/",
        "s3_bucket": "ENV:S3_BUCKET",
        "s3_region": "ENV:S3_REGION",
        "s3_key": "ENV:S3_KEY",
        "s3_secret": "ENV:S3_SECRET"
      },
      "uso": "Anexos de tickets, fotos WhatsApp, relatórios gerados, backups",
      "status": "ativo"
    },
    {
      "id": "portal_docs",
      "nome": "Portal de Documentação",
      "tipo": "documentacao",
      "plataforma": "docusaurus|vitepress|gitbook|custom",
      "conexao": {
        "url_base": "ENV:DOCS_URL",
        "porta": 3010,
        "diretorio": "./docs-portal/"
      },
      "modulos_docs": ["manual_usuario", "referencia_tecnica", "integracao", "faq"],
      "status": "ativo|inativo"
    },
    {
      "id": "api_propria",
      "nome": "API do Sistema (este serviço)",
      "tipo": "api",
      "plataforma": "express_nodejs",
      "conexao": {
        "porta": "ENV:PORT (default 3100)",
        "cors_origins": "ENV:CORS_ORIGIN",
        "api_token": "ENV:API_TOKEN (vazio = sem autenticação)"
      },
      "status": "ativo"
    }
  ],
  "template_novo_sistema": {
