  "event_bus_design": {
    "implementacao": "Node.js EventEmitter nativo — zero dependências externas",
    "arquivo": "axion-ia-panel/api/src/eventBus.js",
    "publishers": {
      "Validator": "bus.emit('cuti:test-completed', data)",
      "Comparator": "bus.emit('comparator:comparison-done', data)",
      "Mission": "bus.emit('mission:completed', data)",
      "HelpDesk": "bus.emit('helpdesk:ticket-resolved', data)",
      "OCR": "bus.emit('ocr:triagem-completed', data)",
      "Varco": "bus.emit('varco:evidence-captured', data)"
    },
    "subscribers": {
      "Knowledge": "bus.on('*', async (data) => knowledgeService.createFromEvent(data))",
      "Presentation": "bus.on('mission:completed', generateReport)",
      "Learning": "bus.on('helpdesk:ticket-resolved', recordPattern)",
      "Dashboard": "bus.on('*', updateStats)",
      "AI": "bus.on('helpdesk:ticket-resolved', updateKBFromResolution)"
    }
  },

