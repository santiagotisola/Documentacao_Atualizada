{
  "name": "axion-presentation-studio",
  "version": "5.0.0",
  "description": "AxionIA Presentation Studio Enterprise — Multi-Agent Documentation Pipeline",
  "type": "module",
  "main": "pipeline.js",
  "scripts": {
    "start":        "node pipeline.js",
    "axhub":        "node pipeline.js --project AxHub",
    "axton":        "node pipeline.js --project AxTon",
    "axcross":      "node pipeline.js --project AxCross",
    "resume":       "node pipeline.js --resume",
    "stage":        "node pipeline.js --from",
    "analyze-only": "node pipeline.js --task analyze",
    "video-only":   "node pipeline.js --task video",
    "update-docs":  "node pipeline.js --task update"
  },
  "dependencies": {
    "openai":      "^4.0.0",
    "dotenv":      "^16.0.0",
    "chalk":       "^5.3.0",
    "ora":         "^7.0.1",
    "puppeteer":   "^22.0.0",
    "marked":      "^12.0.0",
    "js-yaml":     "^4.1.0"
  },
  "engines": { "node": ">=20" }
}
