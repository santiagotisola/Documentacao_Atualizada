  "CAP02_FILOSOFIA": {
    "titulo": "Filosofia — Os 5 Pilares",
    "secoes": {
      "2_1_pilar_conhecimento": {
        "nome": "Pilar 1 — Conhecimento",
        "principio": "Todo conteúdo deve ser compreendido. Nunca apenas copiado.",
        "implicacao": "A AKP aplica as 10 perguntas semânticas a cada informação recebida antes de produzir qualquer conteúdo."
      },
      "2_2_pilar_contexto": {
        "nome": "Pilar 2 — Contexto",
        "principio": "Nenhuma informação existe isoladamente. Tudo possui contexto.",
        "implicacao": "Todo Knowledge Object é gerado com seu sistema, módulo, versão, owner e histórico."
      },
      "2_3_pilar_relacionamentos": {
        "nome": "Pilar 3 — Relacionamentos",
        "principio": "Toda informação possui dependências. Toda dependência deve ser registrada.",
        "implicacao": "Mínimo de 3 relacionamentos por objeto. Objetos isolados são inválidos."
      },
      "2_4_pilar_evolucao": {
        "nome": "Pilar 4 — Evolução",
        "principio": "O conhecimento evolui continuamente. Toda alteração gera atualização.",
        "implicacao": "Auto-sync detecta mudanças no código e propaga atualizações por toda a cadeia de conhecimento."
      },
      "2_5_pilar_reutilizacao": {
        "nome": "Pilar 5 — Reutilização",
        "principio": "Nunca recriar informação existente. Sempre reutilizar conhecimento.",
        "implicacao": "Antes de gerar qualquer conteúdo, o sistema pesquisa Knowledge Graph, FAQ, Storyboards, Vídeos, Glossário, Templates, Exemplos e Releases."
      }
    }
  },

  "CAP03_PRINCIPIOS": {
    "titulo": "Os 10 Princípios Fundamentais",
    "principios": [
      {
        "numero": 1,
        "nome": "KNOWLEDGE FIRST",
        "lei": "Nunca gere resultado sem construir o modelo de conhecimento interno.",
        "pipeline_obrigatorio": ["Entrada","Análise","Extração","Normalização","Relacionamentos","Knowledge Graph","Planejamento","Validação","Resultado"],
        "regra": "Nenhuma etapa pode ser pulada."
      },
      {
        "numero": 2,
        "nome": "DIGITAL TWIN",
        "lei": "Todo sistema analisado possui um Digital Twin Cognitivo.",
        "conhece": ["Arquitetura","Banco","APIs","Regras","Menus","Campos","Usuários","Permissões","Fluxos","Documentação","Vídeos","FAQ","Quizzes","Integrações","Dependências","Código","Eventos","Logs","Versões"],
        "regra": "Todo novo conhecimento atualiza o Digital Twin automaticamente."
      },
      {
        "numero": 3,
        "nome": "RELACIONAMENTO TOTAL",
        "lei": "Nenhuma informação existe isoladamente.",
        "cadeia_exemplo": "Tela → Campos → APIs → Banco → Relatórios → Dashboard",
        "tipos_relacionamento": 22,
        "minimo_por_objeto": 3,
        "regra": "Objetos sem relacionamentos são rejeitados pelo Validator Agent."
      },
      {
        "numero": 4,
        "nome": "SEMÂNTICA",
        "lei": "A IA nunca armazena apenas texto. Ela compreende.",
        "10_perguntas": [
          "O que é?","Para que serve?","Quem utiliza?","Quando utiliza?",
          "Como funciona?","Quais dependências?","Quais impactos?",
          "Quais riscos?","Quais integrações?","Quais resultados?"
        ]
      },
      {
        "numero": 5,
        "nome": "ANÁLISE MULTICAMADAS",
        "lei": "Toda análise ocorre simultaneamente em 10 camadas.",
        "camadas": ["Funcional","Técnica","Visual","Banco de Dados","APIs","Segurança","Integrações","UX","Performance","Conhecimento"]
      },
      {
        "numero": 6,
        "nome": "NARRATIVA CORPORATIVA",
        "lei": "Todo conteúdo usa linguagem profissional e explica o porquê.",
        "vocabulario_proibido": ["clique aqui","aperte","vai aparecer","é simples","simplesmente"],
        "vocabulario_preferido": ["O usuário deverá selecionar...","O sistema apresentará...","Recomenda-se..."],
        "sempre_explicar": ["Objetivo","Motivação","Resultado Esperado","Boas Práticas","Erros Comuns","Consequências"]
      },
      {
        "numero": 7,
        "nome": "MICROLEARNING",
        "lei": "Todo conhecimento é fragmentado automaticamente nos 9 níveis.",
        "niveis": ["15s","30s","45s","60s","90s","5min","15min","30min","Curso Completo"]
      },
      {
        "numero": 8,
        "nome": "REUTILIZAÇÃO",
        "lei": "SE existir conteúdo semelhante: ATUALIZAR. NUNCA duplicar.",
        "pesquisar_antes": ["Knowledge Graph","FAQ","Storyboards","Vídeos","Glossário","Templates","Exemplos","Releases"]
      },
      {
        "numero": 9,
        "nome": "APRENDIZADO CONTÍNUO",
        "lei": "Toda execução produz aprendizado.",
        "registrar": ["Tempo","Modelo","Prompt","Tokens","Resultado","Qualidade","Falhas","Feedback","Relacionamentos","Versão"]
      },
      {
        "numero": 10,
        "nome": "MULTIMODALIDADE",
        "lei": "Todas as origens produzem o mesmo modelo interno.",
        "origens_validas": 19,
        "campos_obrigatorios_todo_objeto": ["owner","data_criacao","ultima_atualizacao","versao","sistema","cliente","projeto","criticidade","confiabilidade","origem","responsavel_tecnico","status"],
        "status_validos": ["rascunho","publicado","arquivado","obsoleto"]
      }
    ]
  },

  "CAP04_GOVERNANCA": {
    "titulo": "Governança e Ciclo de Vida",
    "secoes": {
      "4_1_ciclo_status": {
        "titulo": "Ciclo de Status dos Objetos",
        "fluxo": "rascunho → em_revisao → publicado → arquivado → obsoleto",
        "transicoes": [
          { "de": "rascunho",    "para": "em_revisao", "quem": "Validator Agent (score ≥ 70)" },
          { "de": "em_revisao",  "para": "publicado",  "quem": "Revisor humano ou Validator (score ≥ 85)" },
          { "de": "publicado",   "para": "arquivado",  "quem": "Nova versão publicada" },
          { "de": "qualquer",    "para": "obsoleto",   "quem": "Project Manager Agent" }
        ]
      },
      "4_2_versionamento": {
        "titulo": "Versionamento Semântico",
        "regras": [
          "MAJOR (1.0.0 → 2.0.0): Mudança estrutural no conteúdo ou schema",
          "MINOR (1.0.0 → 1.1.0): Adição de seções, relacionamentos ou campos",
          "PATCH (1.0.0 → 1.0.1): Correção de erros ou atualização menor"
        ]
      },
      "4_3_rastreabilidade": {
        "titulo": "Rastreabilidade Completa",
        "schema_historico": {
          "versao": "string",
          "data": "ISO 8601",
          "autor": "string — agente ou usuário",
          "alteracao": "string — descrição da mudança",
          "tokens_utilizados": "number",
          "modelo_ia": "string",
          "qualidade_antes": "number",
          "qualidade_depois": "number"
        }
      },
      "4_4_regras_governanca": {
        "titulo": "Regras de Governança",
        "lista": [
          "Nenhum objeto vai a 'publicado' sem passar pelo Validator Agent",
          "Todo objeto tem exatamente um 'owner' responsável",
          "Objetos 'obsoletos' nunca são deletados — apenas marcados",
          "Alterações em objetos 'publicados' criam nova versão, preservando a anterior",
          "O Knowledge Graph mantém todas as versões de relacionamentos",
          "Toda deleção é lógica — nunca física"
        ]
      }
    }
  },

