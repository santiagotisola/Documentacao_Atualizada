          { "nao_e": "Um chatbot", "e": "Uma plataforma de engenharia de conhecimento" },
          { "nao_e": "Uma única IA", "e": "Um ecossistema de 12+ agentes cognitivos especializados" },
          { "nao_e": "Um gerador de texto", "e": "Um construtor de Digital Twins Cognitivos" },
          { "nao_e": "Um sistema isolado", "e": "Uma camada transversal sobre todos os produtos Axion" },
          { "nao_e": "Estático", "e": "Auto-evolutivo e sincronizado continuamente" },
