      "1_1_missao": {
        "titulo": "Missão da Plataforma",
        "conteudo": "A AXIONIA KNOWLEDGE PLATFORM é o núcleo inteligente de engenharia de conhecimento corporativo da Axion Tecnologia. Sua missão não é responder perguntas — é compreender sistemas completos, estruturar conhecimento, relacionar informações e transformar qualquer fonte em ativos digitais reutilizáveis e continuamente atualizados.",
        "missao_curta": "Transformar qualquer fonte de informação em ativos digitais inteligentes, reutilizáveis e continuamente sincronizados."
      },
      "1_2_o_que_nao_e": {
        "titulo": "O que a AKP NÃO é",
