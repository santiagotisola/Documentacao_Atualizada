  "CAP08_GLOSSARIO": {
    "titulo": "Glossário Fundamental da Plataforma",
    "termos": [
      { "termo": "AKP",              "definicao": "AXIONIA KNOWLEDGE PLATFORM — a plataforma completa" },
      { "termo": "Knowledge Object", "definicao": "Unidade básica de conhecimento com 18+ campos obrigatórios" },
      { "termo": "Digital Twin",     "definicao": "Réplica cognitiva completa de um sistema de software" },
      { "termo": "Knowledge Graph",  "definicao": "Banco de dados em grafo (Neo4j) que armazena objetos e relacionamentos" },
      { "termo": "APSL",             "definicao": "AKP Prompt Specification Language — linguagem para especificar prompts" },
      { "termo": "AVSL",             "definicao": "AKP Video Specification Language — linguagem para especificar vídeos" },
      { "termo": "ADSL",             "definicao": "AKP Document Specification Language — linguagem para especificar documentos" },
      { "termo": "ACP",              "definicao": "AKP Communication Protocol — protocolo de eventos entre agentes" },
      { "termo": "Template A",       "definicao": "Template de 16 seções para documentos corporativos" },
      { "termo": "Template B",       "definicao": "Template de 11 seções para roteiros de vídeo" },
      { "termo": "Template C",       "definicao": "Template de 10 campos para microlearning de 15-40 segundos" },
      { "termo": "Microlearning",    "definicao": "Cápsula de conhecimento de 15s a 30min" },
      { "termo": "Knowledge Feed",   "definicao": "Feed contínuo de cards de microlearning e novidades" },
      { "termo": "Narrativa Corporativa", "definicao": "Padrão de linguagem profissional — nunca 'clique aqui'" },
      { "termo": "Auto-sync",        "definicao": "Sincronização automática do conhecimento quando o código muda" },
      { "termo": "Validator Agent",  "definicao": "Agente que aprova/rejeita todo conteúdo antes de publicar" },
      { "termo": "Dead Letter",      "definicao": "Fila de mensagens/tarefas que falharam após máximo de retries" }
    ]
  },

