{
  "$schema": "akp-enterprise-spec-v1",
  "documento": "AXIONIA-KNOWLEDGE-PLATFORM — Enterprise Specification",
  "versao": "1.0",
  "ano": 2026,
  "status": "Architecture Definition",
  "autor": "Axion Tecnologia",

  "cap01_identidade": {
    "titulo": "Identidade da Plataforma",
    "missao": "Compreender, estruturar, relacionar e transformar qualquer fonte de informação em ativos digitais reutilizáveis. Nunca apenas responder perguntas.",
    "objetivo_transformar_em": [
      "Manual Técnico", "Manual Operacional", "Manual do Usuário",
      "Vídeo", "Storyboard", "FAQ", "Quiz", "Fluxograma", "Diagrama",
      "Base de Conhecimento", "Central de Ajuda", "Curso",
      "Microlearning", "Você Sabia?", "Release Notes",
      "Treinamentos", "Portal de Conhecimento"
    ],
    "missao_permanente": [
      "Sempre aprender",
      "Sempre documentar",
      "Sempre relacionar",
      "Sempre melhorar",
      "Nunca perder conhecimento"
    ],
    "principios_operacionais": [
      "compreender antes de responder",
      "analisar antes de gerar",
      "relacionar antes de publicar",
      "validar antes de entregar",
      "versionar antes de substituir"
    ],
    "atributos_todo_conhecimento": [
      "origem", "contexto", "relacionamentos", "versionamento",
      "rastreabilidade", "reutilização", "auditoria"
    ]
  },

  "cap02_filosofia": {
    "titulo": "Filosofia — 5 Pilares",
    "pilares": [
      {
        "nome": "Conhecimento",
        "principio": "Todo conteúdo deve ser compreendido. Nunca apenas copiado."
      },
      {
        "nome": "Contexto",
        "principio": "Nenhuma informação existe isoladamente. Tudo possui contexto."
      },
      {
        "nome": "Relacionamentos",
        "principio": "Toda informação possui dependências. Toda dependência deve ser registrada."
      },
      {
        "nome": "Evolução",
        "principio": "O conhecimento evolui continuamente. Toda alteração gera atualização."
      },
      {
        "nome": "Reutilização",
        "principio": "Nunca recriar informação existente. Sempre reutilizar conhecimento."
      }
    ]
  },

  "cap03_objetivos": {
    "titulo": "Objetivos — O que a plataforma compreende",
    "compreende": [
      "Sistemas", "Módulos", "Menus", "Telas", "Campos",
      "APIs", "Banco de Dados", "Fluxos", "Regras",
      "Usuários", "Permissões", "Integrações",
      "Processos", "Dashboards", "Relatórios"
    ],
    "converte_em": "Ativos digitais automaticamente"
  },

  "cap04_dominios": {
    "titulo": "Domínios — 12 Domínios Especializados",
    "dominios": [
      { "nome": "Knowledge",     "responsabilidade": "Extração e estruturação de conhecimento" },
      { "nome": "Documentation", "responsabilidade": "Geração de documentação corporativa" },
      { "nome": "Video",         "responsabilidade": "Produção de vídeos e storyboards" },
      { "nome": "Learning",      "responsabilidade": "Microlearning, quizzes, trilhas" },
      { "nome": "Publishing",    "responsabilidade": "Publicação e distribuição" },
      { "nome": "Analytics",     "responsabilidade": "Métricas e inteligência" },
      { "nome": "Validation",    "responsabilidade": "Qualidade e conformidade" },
      { "nome": "Automation",    "responsabilidade": "Automação via Playwright e OCR" },
      { "nome": "Integration",   "responsabilidade": "Integrações com sistemas externos" },
      { "nome": "AI",            "responsabilidade": "Modelos, prompts e agentes" },
      { "nome": "Security",      "responsabilidade": "Segurança, LGPD, RBAC" },
      { "nome": "Enterprise",    "responsabilidade": "Governança, ciclo de vida, multi-tenant" }
    ]
  },

  "cap05_pipeline_operacional": {
    "titulo": "Princípios Operacionais — Pipeline de 9 Etapas",
    "regra": "Nenhuma etapa poderá ser ignorada.",
    "etapas": [
      { "ordem": 1, "nome": "Entrada",        "descricao": "Receber e classificar a fonte de informação" },
      { "ordem": 2, "nome": "Extração",       "descricao": "Extrair entidades, conceitos e estrutura" },
      { "ordem": 3, "nome": "Normalização",   "descricao": "Normalizar para o modelo interno AKP" },
      { "ordem": 4, "nome": "Análise",        "descricao": "Analisar em 10 camadas simultâneas" },
      { "ordem": 5, "nome": "Relacionamentos","descricao": "Mapear todos os relacionamentos com 22 tipos" },
      { "ordem": 6, "nome": "Knowledge Graph","descricao": "Registrar no grafo central" },
      { "ordem": 7, "nome": "Planejamento",   "descricao": "Planejar outputs necessários" },
      { "ordem": 8, "nome": "Validação",      "descricao": "Validar qualidade e coerência" },
      { "ordem": 9, "nome": "Publicação",     "descricao": "Publicar e distribuir os ativos" }
    ]
  },

  "cap06_digital_twin": {
    "titulo": "Digital Twin Cognitivo",
    "definicao": "Réplica estruturada e inteligente de um sistema de software que conhece completamente o sistema e se atualiza automaticamente.",
    "conhece": [
      "Arquitetura", "Banco", "APIs", "Código", "Interfaces",
      "Permissões", "Fluxos", "Integrações", "Usuários",
      "Vídeos", "Documentação", "FAQs", "Quizzes", "Storyboards"
    ],
    "regra": "Toda atualização no sistema deverá refletir automaticamente no Digital Twin."
  },

  "cap07_knowledge_graph": {
    "titulo": "Knowledge Graph",
    "tecnologia": "Neo4j",
    "entidades_no": [
      "Projeto", "Sistema", "Módulo", "Tela", "Campo",
      "API", "Banco", "Documento", "Vídeo", "Storyboard",
      "FAQ", "Quiz", "Usuário", "Processo"
    ],
    "relacionamentos_arestas": [
      "DEPENDS_ON", "USES", "CALLS", "READS", "WRITES",
      "GENERATES", "BELONGS_TO", "DOCUMENTED_BY", "VIDEO_OF",
      "CONFIGURES", "NEXT", "PREVIOUS", "VALIDATES", "FIXES",
      "IMPORTS", "EXPORTS", "REQUIRES", "CAUSES",
      "CAPTURED_BY", "EXPLAINED_BY", "FAQ_OF", "QUIZ_OF"
    ]
  },

  "cap08_modelo_conhecimento": {
    "titulo": "Modelo de Conhecimento — Schema Universal",
    "descricao": "Todo objeto de conhecimento DEVE conter todos estes campos",
    "schema": {
      "id":            "string — AKP-{SISTEMA}-{TIPO}-{SEQUENCIAL}",
      "name":          "string",
      "type":          "enum: Projeto|Sistema|Módulo|Tela|Campo|API|...",
      "description":   "string",
      "category":      "string",
      "system":        "AxHub | AxTon | AxCross | AxionIA",
      "module":        "string",
      "screen":        "string | null",
      "version":       "string — semver",
      "language":      "pt-BR",
      "owner":         "string",
      "author":        "string",
      "createdAt":     "ISO 8601",
      "updatedAt":     "ISO 8601",
      "status":        "rascunho | publicado | arquivado | obsoleto",
      "relationships": [{ "type": "string", "target_id": "string", "description": "string" }],
      "assets":        ["array de URLs de arquivos relacionados"],
      "metadata":      { "criticality": "string", "reliability": "number 0-100", "origin": "string" },
      "history":       [{ "version": "string", "date": "string", "change": "string", "author": "string" }],
      "knowledge":     { "semantic_answers": {}, "dependencies": [], "impacts": [], "risks": [] }
    }
  },

  "cap09_fontes": {
    "titulo": "Fontes de Conhecimento — 30+ Origens",
    "regra": "Toda fonte deverá ser convertida para o modelo interno comum.",
    "fontes_por_categoria": {
      "documentos_office": ["PDF", "DOCX", "XLSX", "PPTX"],
      "web_markup":        ["Markdown", "HTML", "URL"],
      "api_specs":         ["Swagger", "OpenAPI", "GraphQL", "REST"],
      "bancos_dados":      ["SQL Server", "PostgreSQL", "Oracle", "MongoDB"],
      "codigo_frontend":   ["React", "Angular", "Vue"],
      "codigo_backend":    [".NET", "Node.js", "Java", "Python"],
      "automacao_midia":   ["OCR", "Playwright", "Imagens", "Áudios", "Vídeos"],
      "dados_estruturados":["JSON", "XML", "CSV"],
      "infra_devops":      ["Logs", "Git", "ZIP"]
    },
    "total": 30
  },

  "cap10_resultados": {
    "titulo": "Resultados Esperados — 18 Outputs por Fonte",
    "regra": "Para cada fonte analisada, gerar automaticamente todos os outputs abaixo.",
    "outputs": [
      { "id": "OUT-01", "nome": "Manual Técnico",          "template": "A", "publico": "developer" },
      { "id": "OUT-02", "nome": "Manual Operacional",      "template": "A", "publico": "supervisor" },
      { "id": "OUT-03", "nome": "Manual do Usuário",       "template": "A", "publico": "operator" },
      { "id": "OUT-04", "nome": "Storyboard",              "template": "B-plan", "publico": "all" },
      { "id": "OUT-05", "nome": "Roteiro Narrado",         "template": "B-narration", "publico": "all" },
      { "id": "OUT-06", "nome": "Vídeo Completo",          "template": "B", "publico": "all" },
      { "id": "OUT-07", "nome": "Microlearning",           "template": "C", "publico": "all" },
      { "id": "OUT-08", "nome": "Você Sabia?",             "template": "C-15s", "publico": "all" },
      { "id": "OUT-09", "nome": "FAQ",                     "template": "FAQ", "publico": "all" },
      { "id": "OUT-10", "nome": "Quiz",                    "template": "QUIZ", "publico": "all" },
      { "id": "OUT-11", "nome": "Fluxograma",              "template": "FLOW", "publico": "all" },
      { "id": "OUT-12", "nome": "Diagrama",                "template": "DIAG", "publico": "developer" },
      { "id": "OUT-13", "nome": "Base de Conhecimento",   "template": "KB", "publico": "all" },
      { "id": "OUT-14", "nome": "Portal de Ajuda",        "template": "PORTAL", "publico": "operator" },
      { "id": "OUT-15", "nome": "Glossário",               "template": "GLOSS", "publico": "all" },
      { "id": "OUT-16", "nome": "Checklist",               "template": "CHECK", "publico": "operator" },
      { "id": "OUT-17", "nome": "Release Notes",          "template": "RELEASE", "publico": "all" },
      { "id": "OUT-18", "nome": "Analytics",               "template": "ANALYTICS", "publico": "manager" }
    ]
  },

  "cap11_regras_gerais": {
    "titulo": "Regras Gerais",
    "nunca": [
      "inventar informações",
      "ocultar incertezas",
      "duplicar conhecimento",
      "perder contexto",
      "quebrar relacionamentos",
      "gerar documentação inconsistente",
      "gerar vídeos sem validação",
      "publicar conteúdo sem versionamento"
    ],
    "sempre": [
      "solicitar mais dados quando necessário",
      "validar coerência entre fontes",
      "registrar histórico de alterações",
      "reutilizar conhecimento existente",
      "manter rastreabilidade completa",
      "produzir saídas reutilizáveis",
      "aprender continuamente com feedback",
      "preservar a consistência do ecossistema de conhecimento"
    ]
  },

