      }
    },
    
    "standardFooterTemplate": {
      "layout": "horizontal",
      "example": "AxHub v.1.2.4 | © 2026 Axion Tecnologia | www.axiontecnologia.com.br | Suporte: suporte@axiontecnologia.com.br",
      "css": {
        "fontSize": "12px",
        "color": "#6b7280",
        "backgroundColor": "#f9fafb",
        "padding": "1rem",
        "textAlign": "center",
        "borderTop": "1px solid #e5e7eb"
