  "synchronization": {
    "automated": true,
    "description": "Sempre que uma nova versão for publicada, atualizar automaticamente todos os ambientes",
    
    "workflow": [
      {
        "step": 1,
        "action": "Nova versão criada (Git tag ou package.json atualizado)",
        "trigger": "CI/CD pipeline"
      },
      {
        "step": 2,
        "action": "Build e deploy da aplicação",
        "output": "Artefatos de produção"
      },
      {
        "step": 3,
        "action": "Atualizar API /api/version com nova versão",
        "database": "MongoDB - collection: versions"
      },
      {
        "step": 4,
        "action": "Gerar version.json em todos os builds",
        "location": "./public/version.json"
      },
      {
        "step": 5,
        "action": "Sincronizar rodapé de todos os contratos",
        "method": "Atualização em cascata"
      },
      {
        "step": 6,
        "action": "Atualizar portais administrativos",
        "targets": ["AxHub Admin", "AxCross Admin", "AxTon Admin"]
      },
      {
        "step": 7,
        "action": "Atualizar dashboards",
        "targets": ["AxDashboard", "AxionIA Painel"]
      },
      {
        "step": 8,
        "action": "Atualizar páginas institucionais relacionadas",
        "targets": ["Documentação", "Landing pages"]
      },
      {
        "step": 9,
        "action": "Validar consistência após publicação",
        "method": "Executar auditoria imediata"
      },
      {
        "step": 10,
        "action": "Notificar equipes",
        "channels": ["Slack", "Email"]
      }
    ],
    
    "rollback": {
      "enabled": true,
      "method": "Git revert + redeploy",
      "notification": "Notificar equipes sobre rollback"
    }
  },
  
  "implementation": {
    "frontend": {
      "component": "VersionFooter.jsx",
      "location": "src/components/Layout/VersionFooter.jsx",
      
      "code": {
        "react": "// VersionFooter.jsx\nimport { useState, useEffect } from 'react';\n\nconst VersionFooter = ({ system }) => {\n  const [versionInfo, setVersionInfo] = useState(null);\n\n  useEffect(() => {\n    // Tentar buscar de API primeiro\n    fetch('/api/version')\n      .then(res => res.json())\n      .then(data => setVersionInfo(data))\n      .catch(() => {\n        // Fallback: buscar version.json\n        fetch('/version.json')\n          .then(res => res.json())\n          .then(data => setVersionInfo(data))\n          .catch(() => {\n            // Fallback final: package.json\n            setVersionInfo({\n              system: system,\n              version: process.env.REACT_APP_VERSION || 'dev'\n            });\n          });\n      });\n  }, [system]);\n\n  if (!versionInfo) return null;\n\n  const currentYear = new Date().getFullYear();\n\n  return (\n    <footer className=\"version-footer\">\n      <div className=\"footer-content\">\n        <span className=\"system-info\">\n          {versionInfo.system} v.{versionInfo.version}\n        </span>\n        <span className=\"separator\">|</span>\n        <span className=\"copyright\">\n          © {currentYear} Axion Tecnologia\n        </span>\n        <span className=\"separator\">|</span>\n        <a \n          href=\"https://www.axiontecnologia.com.br\"\n          target=\"_blank\"\n          rel=\"noopener noreferrer\"\n          className=\"institutional-link\"\n        >\n          www.axiontecnologia.com.br\n        </a>\n        <span className=\"separator\">|</span>\n        <span className=\"support\">\n          Suporte: suporte@axiontecnologia.com.br\n        </span>\n      </div>\n    </footer>\n  );\n};\n\nexport default VersionFooter;"
      }
    },
    
    "backend": {
      "endpoint": "/api/version",
      "method": "GET",
      "controller": "VersionController.js",
      
      "code": {
        "nodejs": "// VersionController.js\nconst packageJson = require('../../package.json');\nconst versionModel = require('../models/Version');\n\nconst getVersion = async (req, res) => {\n  try {\n    // Buscar versão do banco (Single Source of Truth)\n    const currentVersion = await versionModel.findOne({ active: true });\n    \n    if (currentVersion) {\n      return res.json({\n        system: currentVersion.system,\n        version: currentVersion.version,\n        buildDate: currentVersion.buildDate,\n        buildNumber: currentVersion.buildNumber,\n        environment: process.env.NODE_ENV,\n        commit: currentVersion.commit\n      });\n    }\n    \n    // Fallback: package.json\n    res.json({\n      system: 'AxHub',\n      version: packageJson.version,\n      buildDate: new Date().toISOString(),\n      environment: process.env.NODE_ENV\n    });\n  } catch (error) {\n    console.error('Erro ao buscar versão:', error);\n    res.status(500).json({ error: 'Erro ao buscar versão' });\n  }\n};\n\nmodule.exports = { getVersion };"
      },
      
      "database": {
        "collection": "versions",
        "schema": {
          "system": "String (AxHub, AxCross, AxTon)",
          "version": "String (1.2.4)",
          "buildDate": "Date",
          "buildNumber": "String (2024.06.23.1)",
          "commit": "String (hash do Git)",
          "active": "Boolean",
          "createdAt": "Date",
          "updatedAt": "Date"
        }
      }
    },
    
    "cicd": {
      "pipeline": "Azure DevOps / GitHub Actions / GitLab CI",
      
      "steps": [
        {
          "name": "Extract Version",
          "command": "git describe --tags --abbrev=0 | sed 's/v//'"
        },
        {
          "name": "Generate version.json",
          "command": "echo '{\"system\":\"AxHub\",\"version\":\"'$VERSION'\",\"buildDate\":\"'$(date -u +%Y-%m-%dT%H:%M:%S.000Z)'\",\"commit\":\"'$COMMIT_SHA'\"}' > public/version.json"
        },
        {
          "name": "Update Database",
          "command": "node scripts/update-version-db.js --version $VERSION --commit $COMMIT_SHA"
        },
        {
          "name": "Build Application",
          "command": "npm run build"
        },
        {
          "name": "Deploy",
          "command": "npm run deploy"
        },
        {
          "name": "Audit Environments",
          "command": "node scripts/audit-versions.js --notify"
        }
      ]
    }
  },
  
