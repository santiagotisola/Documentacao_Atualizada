{
  "version": "1.0.0",
  "moduleName": "Global Version Management & Standardization — AxionIA v4.0",
  "description": "Motor de auditoria, sincronização e padronização de versionamento para todos os ambientes, contratos e portais Axion. Garante consistência institucional e rastreabilidade de versões.",
  "lastUpdate": "2026-06-23",
  "integration": "Governance Engine (v4.0)",
  
  "problem": {
    "identified": "Ambientes não apresentam versão corretamente ou exibem informações inconsistentes",
    "example": {
      "environment": "Goiânia",
      "url": "https://goiania.axhub.axion.ws/",
      "issue": "Não apresenta corretamente o versionamento da aplicação",
      "expected": "AxHub v.1.2.4",
      "actual": "Sem informação de versão no rodapé"
    },
    
    "impacts": [
      "Dificuldade no suporte técnico (não sabe qual versão o cliente usa)",
      "Inconsistência visual entre ambientes",
      "Problemas em auditorias",
      "Falta de rastreabilidade de versões",
      "Confusão para equipes de manutenção",
      "Má impressão profissional"
    ]
  },
  
  "objective": {
    "primary": "Implementar mecanismo centralizado de auditoria e sincronização de versões",
    "goals": [
      "Garantir que todos os ambientes exibam corretamente a versão",
      "Evitar divergências entre instâncias",
      "Padronizar informações institucionais",
      "Automatizar atualização de versões",
      "Criar auditoria recorrente",
      "Gerar relatórios de conformidade"
    ]
  },
  
  "scope": {
    "environments": [
      "Produção",
      "Homologação",
      "Desenvolvimento",
      "Testes",
      "UAT (User Acceptance Testing)"
    ],
    
    "applications": [
      "AxHub (principais e contratos)",
      "AxCross (principais e contratos)",
      "AxTon (principais e contratos)",
      "AxionIA Painel",
      "AxDashboard",
      "Multi360",
      "VARCO",
      "APIs públicas (Swagger/OpenAPI)",
      "Portais de documentação (Docusaurus)",
      "Microsserviços com interface web",
      "Páginas institucionais",
      "Landing pages",
      "Portais administrativos"
    ],
    
    "contracts": [
      "Todos os contratos cadastrados no sistema",
      "Exemplo: IPEM/PA, Goiânia, etc."
    ]
  },
  
  "validation": {
    "footerElements": {
      "systemName": {
        "required": true,
        "format": "AxHub | AxCross | AxTon | AxionIA",
        "example": "AxHub",
        "location": "rodapé, canto esquerdo ou centro"
      },
      
      "version": {
        "required": true,
        "format": "v.{major}.{minor}.{patch}",
        "example": "v.1.2.4",
        "pattern": "^v\\.[0-9]+\\.[0-9]+\\.[0-9]+$",
        "location": "rodapé, após nome do sistema"
      },
      
      "companyName": {
        "required": true,
        "standard": "Axion Tecnologia",
        "notAllowed": ["AXION", "axion", "Axion Tech", "Axiontecnologia"],
        "location": "rodapé, linha do copyright"
      },
      
      "copyright": {
        "required": true,
        "format": "© {year} Axion Tecnologia",
        "example": "© 2026 Axion Tecnologia",
        "autoUpdate": true,
        "location": "rodapé"
      },
      
      "institutionalLink": {
        "required": true,
        "url": "https://www.axiontecnologia.com.br",
        "text": "www.axiontecnologia.com.br",
        "openInNewTab": true,
        "location": "rodapé"
      },
      
      "supportContact": {
        "required": true,
        "options": [
          {
            "type": "email",
            "value": "suporte@axiontecnologia.com.br",
            "display": "Suporte: suporte@axiontecnologia.com.br"
          },
          {
            "type": "phone",
            "value": "(62) 3XXX-XXXX",
            "display": "Tel: (62) 3XXX-XXXX"
          },
          {
            "type": "link",
            "value": "https://desk.axiontecnologia.com.br/helpdesk",
            "display": "Central de Atendimento"
          }
        ],
        "location": "rodapé ou menu ajuda"
      },
      
      "releaseDate": {
        "required": false,
        "format": "DD/MM/YYYY",
        "example": "23/06/2026",
        "displayAs": "Atualizado em: 23/06/2026",
        "location": "rodapé (opcional)"
      },
      
      "buildNumber": {
        "required": false,
