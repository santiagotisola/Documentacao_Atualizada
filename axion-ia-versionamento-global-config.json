  "versionSource": {
    "principle": "Single Source of Truth",
    "description": "A versão NÃO deve ser cadastrada manualmente em cada ambiente. Deve ser obtida automaticamente de uma fonte única.",
    
    "options": [
      {
        "method": "package.json",
        "description": "Ler versão do package.json do projeto",
        "path": "./package.json",
        "field": "version",
        "example": {
          "version": "1.2.4"
        },
        "pros": ["Simples", "Padrão NPM", "Versionamento semântico"],
        "cons": ["Precisa rebuild para atualizar"]
      },
      
      {
        "method": "Environment Variable",
        "description": "Versão injetada via variável de ambiente",
        "variable": "REACT_APP_VERSION",
        "example": "REACT_APP_VERSION=1.2.4",
        "pros": ["Flexível", "Sem rebuild", "CI/CD friendly"],
        "cons": ["Precisa configurar em cada ambiente"]
      },
      
      {
        "method": "API Endpoint",
        "description": "Buscar versão de endpoint centralizado",
        "endpoint": "GET /api/version",
        "response": {
          "system": "AxHub",
          "version": "1.2.4",
          "buildDate": "2026-06-23",
          "buildNumber": "2024.06.23.1",
          "environment": "production"
        },
        "pros": ["Centralizado", "Tempo real", "Auditável"],
        "cons": ["Dependência de API", "Mais complexo"]
      },
      
      {
        "method": "version.json",
        "description": "Arquivo JSON estático gerado no build",
        "path": "./public/version.json",
        "content": {
          "system": "AxHub",
          "version": "1.2.4",
          "buildDate": "2026-06-23T19:30:00.000Z",
          "buildNumber": "2024.06.23.1",
          "commit": "abc123def456"
        },
        "pros": ["Simples", "Sem API", "Rápido"],
        "cons": ["Precisa rebuild"]
      },
      
      {
        "method": "Git Tag",
        "description": "Versão extraída de tag Git durante build",
        "command": "git describe --tags --abbrev=0",
        "example": "v1.2.4",
        "pros": ["Rastreável", "Versionamento oficial", "CI/CD"],
        "cons": ["Precisa tags no Git"]
      }
    ],
    
    "recommended": {
      "method": "API Endpoint + version.json (fallback)",
      "reason": "Combina centralização com redundância"
    }
  },
  
  "audit": {
    "automated": true,
    "frequency": "daily",
    "time": "03:00",
    "timezone": "America/Sao_Paulo",
    
    "checks": [
      {
        "id": "version_missing",
        "name": "Ambientes sem informação de versão",
        "severity": "critical",
        "action": "Corrigir imediatamente"
      },
      {
        "id": "version_divergent",
        "name": "Ambientes com versão divergente do esperado",
        "severity": "high",
        "action": "Investigar e corrigir"
      },
      {
        "id": "footer_incomplete",
        "name": "Ambientes com rodapé incompleto",
        "severity": "medium",
        "action": "Completar informações"
      },
      {
        "id": "institutional_text_different",
        "name": "Ambientes com textos institucionais diferentes",
        "severity": "medium",
        "action": "Padronizar"
      },
      {
        "id": "links_invalid",
        "name": "Ambientes com links inválidos",
        "severity": "high",
        "action": "Corrigir URLs"
      },
      {
        "id": "emails_outdated",
        "name": "Ambientes com e-mails desatualizados",
        "severity": "medium",
        "action": "Atualizar contatos"
      },
      {
        "id": "nomenclature_inconsistent",
        "name": "Ambientes com nomenclatura inconsistente",
        "severity": "low",
        "action": "Padronizar nomes"
      },
      {
        "id": "copyright_year_outdated",
        "name": "Copyright com ano desatualizado",
        "severity": "low",
        "action": "Atualizar ano automaticamente"
      },
      {
        "id": "system_name_wrong",
        "name": "Nome do sistema incorreto",
        "severity": "critical",
        "action": "Corrigir imediatamente"
      }
    ],
    
    "discovery": {
      "method": "web_scraping",
      "tools": ["Puppeteer", "Playwright", "Selenium"],
      "steps": [
        "1. Obter lista de todos os ambientes cadastrados",
        "2. Para cada ambiente, acessar a URL",
        "3. Extrair conteúdo do rodapé (footer)",
        "4. Parsear informações (nome, versão, copyright, links)",
        "5. Comparar com padrão esperado",
        "6. Gerar relatório de conformidade"
      ]
    }
  },
  
