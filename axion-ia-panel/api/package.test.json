{
  "name": "axion-ia-api-tests",
  "version": "1.0.0",
  "description": "Suite de testes para LGPD Gate",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:lgpd": "node --experimental-vm-modules node_modules/jest/bin/jest.js whatsapp-flow.test.js",
    "test:security": "node --experimental-vm-modules node_modules/jest/bin/jest.js whatsapp-flow.test.js -t 'TC015|TC016|TC056|TC057|TC058|TC059|TC060'",
    "test:critical": "node --experimental-vm-modules node_modules/jest/bin/jest.js whatsapp-flow.test.js -t 'TC001|TC014|TC015|TC016|TC018|TC019'"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!src/**/*.spec.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 90,
        "lines": 85,
        "statements": 85
      }
    },
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/?(*.)+(spec|test).js"
    ],
    "transform": {},
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testTimeout": 10000,
    "verbose": true,
    "bail": false,
    "maxWorkers": "50%"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0"
  }
}
