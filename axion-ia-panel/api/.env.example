# ═══════════════════════════════════════════════════════════════
# AxionIA API — Configuração de Ambiente
# Copie para .env e preencha com seus valores
# ═══════════════════════════════════════════════════════════════

# API Server
PORT=3100
CORS_ORIGIN=http://localhost:3001

# Autenticação da API (opcional — deixe vazio para desativar)
# API_TOKEN=

# OpenAI (obrigatório para respostas IA)
OPENAI_API_KEY=sk-proj-SUA_CHAVE_AQUI

# MongoDB (obrigatório — armazena sessões, logs, histórico)
MONGO_URI=mongodb://localhost:27017/axion-ia

# ═══════════════════════════════════════════════════════════════
# Jitbit Helpdesk (obrigatório para integração de tickets)
# ═══════════════════════════════════════════════════════════════
# URL base DEVE incluir /helpdesk (NÃO use a URL da página de login!)
# Correto:  https://meudominio.com.br/helpdesk
# Errado:   https://meudominio.com.br/helpdesk/User/Login
JITBIT_URL=https://SEU-DOMINIO.com.br/helpdesk
JITBIT_USER=admin@empresa.com.br
# ⚠️ Se a senha contém # use aspas duplas: "Senha#123"
JITBIT_PASS="SuaSenha"

# ═══════════════════════════════════════════════════════════════
# SQL Server — AxHub (opcional)
# ═══════════════════════════════════════════════════════════════
AXHUB_DB_HOST=localhost
AXHUB_DB_PORT=1433
AXHUB_DB_NAME=AxHub
AXHUB_DB_USER=
AXHUB_DB_PASS=
AXHUB_DB_ENCRYPT=false

# ═══════════════════════════════════════════════════════════════
# SQL Server — AxTon (opcional)
# ═══════════════════════════════════════════════════════════════
AXTON_DB_HOST=localhost
AXTON_DB_PORT=1433
AXTON_DB_NAME=AxTon
AXTON_DB_USER=
AXTON_DB_PASS=
AXTON_DB_ENCRYPT=false

# ═══════════════════════════════════════════════════════════════
# SQL Server — AxCross (opcional)
# ═══════════════════════════════════════════════════════════════
AXCROSS_DB_HOST=localhost
AXCROSS_DB_PORT=1433
AXCROSS_DB_NAME=AxCross
AXCROSS_DB_USER=
AXCROSS_DB_PASS=
AXCROSS_DB_ENCRYPT=false

# Telegram (opcional)
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

# ═══════════════════════════════════════════════════════════════
# VARCO IoT Platform (obrigatório para /api/varco/frota)
# ═══════════════════════════════════════════════════════════════
VARCO_EMAIL=suporte@axiontecnologia.com.br
VARCO_PASSWORD=SuaSenhaVARCO
