# ═══════════════════════════════════════════════════════════════════
# PORTAL DO CIDADÃO - VARIÁVEIS DE AMBIENTE
# ═══════════════════════════════════════════════════════════════════

# ─── JWT Authentication ────────────────────────────────────────────
# Chave secreta para assinar tokens JWT (gere uma chave aleatória forte)
# Exemplo: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ─── Criptografia AES-256 ──────────────────────────────────────────
# Chave para criptografar CPF em repouso (32 bytes em hex)
# Exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-32-byte-encryption-key-in-hex-format

# ─── Google reCAPTCHA v3 ───────────────────────────────────────────
# Obtenha em: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# ─── AWS S3 (Upload de Documentos) ─────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=axion-portal-documentos

# ─── OpenAI (Chat IA) ──────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key

# ─── WhatsApp Business API ─────────────────────────────────────────
WHATSAPP_API_URL=https://api.whatsapp.com/v1
WHATSAPP_API_KEY=your-whatsapp-api-key
WHATSAPP_PHONE_NUMBER=+5581999999999

# ─── SMTP (Email Notifications) ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@axion.com.br
SMTP_PASS=your-smtp-password
SMTP_FROM=Portal do Cidadão <noreply@axion.com.br>

# ─── Rate Limiting ─────────────────────────────────────────────────
# Limites personalizados (opcional - padrão: 10 consultas/min)
RATE_LIMIT_CONSULTA=10
RATE_LIMIT_AUTH=5
RATE_LIMIT_CONTESTACAO=5

# ─── URLs ──────────────────────────────────────────────────────────
# URL do frontend (para CORS e emails)
FRONTEND_URL=http://localhost:3013

# ─── Logs e Monitoramento ──────────────────────────────────────────
LOG_LEVEL=info
ENABLE_ANALYTICS=true
